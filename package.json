{
  "name": "morphui-react",
  "version": "1.4.1",
  "description": "MorphUI: A flexible, adaptable React + TypeScript UI component library for modern web apps.",
  "module": "dist/index.esm.js",
  "types": "./dist/components/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "typescript",
    "ui",
    "components",
    "design-system",
    "morphui",
    "storybook",
    "accessible",
    "modern"
  ],
  "author": "mysstique",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Something-important/MorphUI.git"
  },
  "homepage": "https://something-important.github.io/MorphUI",
  "bugs": {
    "url": "https://github.com/Something-important/MorphUI/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:all": "npm run build:types && npm run build && npm run build:css",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier . -w",
    "format:check": "prettier . -c",
    "tokens:generate": "python3 scripts/generate_theme_css.py",
    "tokens:check": "python3 scripts/check_theme_tokens.py",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run tokens:check && npm test && npm run build:all",
    "prepublishOnly": "npm run build:all",
    "prepack": "npm run build:all",
    "size": "size-limit",
    "build:css": "node scripts/generate_component_css.cjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-docs": "^9.0.12",
    "@storybook/addon-onboarding": "^9.0.12",
    "@storybook/react-vite": "^9.0.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "^4.9.1",
    "babel-jest": "^30.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-testing-library": "^6.2.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^30.0.2",
    "prettier": "^3.3.3",
    "rollup": "^4.44.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "size-limit": "^14.3.0",
    "storybook": "^9.0.12",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.0"
  },
